# Copy to .env.local for local development. Never commit real values.

# Public (shipped to the browser, safe): Supabase project URL and anon/publishable key.
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=

# Server only (used by /api functions and scripts). NEVER prefix with VITE_.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Any random string; salts the IP hashes used for login rate limiting.
LOGIN_HASH_SALT=

# Only for `npm run db:apply` (Project Settings -> Database -> Connection string).
DATABASE_URL=
